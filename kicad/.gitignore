# KiCad (applies only to the kicad/ directory)
# Based on https://github.com/github/gitignore/blob/main/KiCad.gitignore
# (*.xml and *.csv BOM exports are not ignored, they would match pom.xml)
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#
# Netlist files (exported from Eeschema)
*.net
# Autorouter files (exported from Pcbnew)
*.dsn
*.ses
