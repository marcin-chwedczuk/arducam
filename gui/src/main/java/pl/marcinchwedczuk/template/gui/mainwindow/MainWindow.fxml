<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.Pane?>
<BorderPane minHeight="600" minWidth="900"
            styleClass="mainWindow" stylesheets="@MainWindow.css"
            xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/"
            fx:controller="pl.marcinchwedczuk.template.gui.mainwindow.MainWindow"
            fx:id="mainWindow">
    <top>
        <VBox>
            <ToolBar>
                <Label>Serial port:</Label>
                <ComboBox fx:id="serialPortComboBox" />
                <Button fx:id="refreshSerialPortsButton" onAction="#refreshSerialPorts">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="@view-refresh.png" />
                        </ImageView>
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL" />
                <Button fx:id="connectButton" onAction="#connect">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="@camera-video.png" />
                        </ImageView>
                    </graphic>
                    Connect
                </Button>
                <Button fx:id="disconnectButton" onAction="#disconnect">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="@process-stop.png" />
                        </ImageView>
                    </graphic>
                    Disconnect
                </Button>

                <Separator orientation="VERTICAL" />
                <Button fx:id="exitButton" onAction="#closeApp">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="@system-restart.png" />
                        </ImageView>
                    </graphic>
                    Exit
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <TextArea editable="false" fx:id="logTextArea" styleClass="log-window" />
    </center>

    <bottom>
        <HBox>
            <Pane minWidth="20" />
            <Separator orientation="VERTICAL" />
            <Label>Ready</Label>
            <Separator orientation="VERTICAL" />
        </HBox>
    </bottom>
</BorderPane>
